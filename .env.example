# Copy to `.env` and fill in values (see DEPLOY.md).

# Local Docker MySQL (see docker-compose.yml):
DATABASE_URL="mysql://herbal:herbal@127.0.0.1:3306/herbal_center"

AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"

# Production: this email is always granted admin. Required on Railway/Vercel — without it,
# nobody is auto-promoted (first signup is NOT made admin).
# SUPER_ADMIN_EMAIL=you@example.com

# Railway (מומלץ): חברו Volume אל /app/public/uploads כדי לשמור תמונות באופן קבוע.
# אין משתנה חובה — זו הגדרת תשתית במסך של Railway.
#
# Vercel Blob — רק אם נשארים על Vercel (הדיסק שם read-only).
# ב-Vercel: Project → Storage → Create Blob Store → Connect to Project (נוסף אוטומטית BLOB_READ_WRITE_TOKEN).
# BLOB_READ_WRITE_TOKEN=
#
# Blob Store פרטי (Private) — בפריסה על Vercel ה־put משתמש ב־private כברירת מחדל (לא חובה להגדיר).
# אם החנות ציבורית בלבד, הגדירו:
# VERCEL_BLOB_PUBLIC_STORE=true
# NEXT_PUBLIC_VERCEL_BLOB_ACCESS=public
#
# כפייה מפורשת לפרטי (אופציונלי) + תצוגה בדפדפן דרך proxy:
# VERCEL_BLOB_PRIVATE_STORE=true
# NEXT_PUBLIC_VERCEL_BLOB_ACCESS=private

# Google OAuth (Auth.js / NextAuth — Sign in with Google)
# Preferred names (see https://authjs.dev/getting-started/providers/google):
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# Or legacy:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Authorized redirect URI in Google Cloud Console:
#   {AUTH_URL}/api/auth/callback/google
# (e.g. https://your-domain.com/api/auth/callback/google)

# Payments — not wired yet (manual waitlist / bank transfer). Keys are ignored until Checkout is implemented.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Unsplash (optional — חיפוש תמונות בניהול תוכן / פרופיל)
# UNSPLASH_ACCESS_KEY=

# Resend — שליחת מייל אוטומטית לבקשות פגישה כלליות (אופציונלי). MAIL_FROM חייב להיות דומיין מאומת ב-Resend.
# RESEND_API_KEY=
# MAIL_FROM="Herbal Center <noreply@yourdomain.com>"
